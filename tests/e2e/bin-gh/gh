def api():
    rest = [a for a in argv[1:]]
    host = opt("--hostname")
    path = next((a for a in rest if a.startswith("/")), "")
    if host and host != "github.com":
        fail(f"error connecting to {host}")
    prefix = "/repos/" + REPO
    if path.startswith("/search/"):
        q = next((a[2:] for a in opts("-f") if a.startswith("q=")), "")
        per_page = int(next((a[9:] for a in opts("-F") if a.startswith("per_page=")), "30"))
        if "INVALID" in q:
            fail("gh: Validation Failed (HTTP 422)", json.dumps({"message": "Validation Failed", "errors": [
                {"resource": "Search", "field": "q", "code": "invalid"}], "documentation_url": "https://docs.github.com"}))
        if "nothing" in q: out({"total_count": 0, "incomplete_results": False, "items": []})
        kind = path[len("/search/"):]
        if kind == "issues":
            if "is:pr" in q:
                items = [issue_item(12, "Add frobnicator", "open", "dave", pr=None, labels=["enhancement"]),
                         issue_item(11, "Old change", "closed", "erin", pr="2026-09-01T00:00:00Z")]
            else:
                items = [issue_item(7, "Crash on start", "open", "alice", labels=["bug", "p1"]),
                         issue_item(8, "Docs typo", "closed", "carol")]
                items[1]["user"] = None
        elif kind == "code":
            items = [{"name": "frob.c", "path": "src/frob.c", "sha": "deadbeefcafebabe0123", "html_url": URL + "/blob/main/src/frob.c",
                      "repository": {"full_name": REPO}, "text_matches": [{"property": "content", "fragment": "int\tfrob(void) {\n  return 1;"}]},
                     {"name": "x.h", "path": "x.h", "repository": {"full_name": REPO}}]
        elif kind == "commits":
            items = [{"sha": "c0ffee0000000000000000000000000000000001", "node_id": "C_1", "html_url": URL + "/commit/c0ffee",
                      "author": {"login": "dave"}, "commit": {"author": {"name": "Dave", "date": "2026-10-07T09:00:00Z"},
                                                             "message": "Add frobnicator\n\nLong body"}, "repository": {"full_name": REPO}},
                     {"sha": "beef", "commit": {"committer": {"name": "Bot", "date": "2026-10-06T09:00:00Z"}, "message": ""}}]
        else:
            items = [{"full_name": REPO, "description": "Widgets for acme\nsecond line", "language": "C", "stargazers_count": 42,
                      "forks_count": 3, "open_issues_count": 5, "archived": False, "fork": False, "private": False,
                      "visibility": "public", "updated_at": "2026-10-30T12:00:00Z", "html_url": URL, "owner": {"login": "acme"}},
                     {"full_name": "acme/old", "description": None, "archived": True, "fork": True}]
        out({"total_count": len(items), "incomplete_results": False, "items": items[:per_page]})
    if not path.startswith(prefix + "/") and path != prefix:
        fail("gh: Not Found (HTTP 404)", json.dumps({"message": "Not Found", "documentation_url": "https://docs.github.com/rest", "status": "404"}))
    sub = path[len(prefix):]
    if sub.startswith("/contents/"):
        p = sub[len("/contents/"):]
        if p not in CONTENTS:
            fail("gh: Not Found (HTTP 404)", json.dumps({"message": "Not Found", "documentation_url": "https://docs.github.com/rest/repos/contents", "status": "404"}))
        out(CONTENTS[p])
    if sub == "/pulls/12/comments":
        page = next((a[5:] for a in opts("-F") if a.startswith("page=")), "1")
        out(PR_REVIEW_COMMENTS if page == "1" else [])
    if sub.startswith("/branches/"):
        b = sub[len("/branches/"):]
        if b == "main": out({"name": "main", "commit": {"sha": RUN_OK["head_sha"]}})
        if b == "nocheck": out({"name": "nocheck", "commit": {"sha": "f00d000000000000000000000000000000000002"}})
        fail("gh: Branch not found (HTTP 404)", json.dumps({"message": "Branch not found", "status": "404"}))
    if sub == "/actions/runs":
        sha = next((a[9:] for a in opts("-F") if a.startswith("head_sha=")), "")
        if sha == RUN_OK["head_sha"]:
            runs = [RUN_OK] if os.environ.get("FAKE_GH_RUNS") == "ok" else [RUN_OK, RUN_FAIL]
            out({"total_count": len(runs), "workflow_runs": runs})
        out({"total_count": 0, "workflow_runs": []})
    for run in (RUN_OK, RUN_FAIL):
        rid = run["id"]
        if sub == f"/actions/runs/{rid}": out(run)
        if sub == f"/actions/runs/{rid}/jobs": out({"total_count": len(JOBS[rid]), "jobs": JOBS[rid]})
    if sub.startswith("/actions/jobs/") and sub.endswith("/logs"):
        jid = int(sub.split("/")[3])
        if jid in JOB_LOGS:
            sys.stdout.write(JOB_LOGS[jid]); sys.exit(0)
        fail("gh: Not Found (HTTP 404)", json.dumps({"message": "Not Found", "status": "404"}))
    fail("gh: Not Found (HTTP 404)", json.dumps({"message": "Not Found", "status": "404"}))

def cmd_repo_view():
    target = argv[2] if len(argv) > 2 and not argv[2].startswith("-") else None
    if target is None and not in_git_repo():
        fail("failed to run git: fatal: not a git repository (or any of the parent directories): .git")
    if target and target.split("/")[-1] == "missing":
        fail(f"GraphQL: Could not resolve to a Repository with the name '{target}'. (repository)")
    if target and target.endswith("Fork-Owner/widgets"):
        out(fields({"nameWithOwner": "Fork-Owner/widgets", "url": "https://github.com/Fork-Owner/widgets",
                    "sshUrl": os.environ.get("FAKE_GH_FORK", "git@github.com:Fork-Owner/widgets.git")}))
    if opt("-q") == ".url": out(URL)
    out(fields(REPO_DATA))

def cmd_issue_view():
    n = argv[2]
    if not n.isdigit() or int(n) not in ISSUES:
        fail(f"GraphQL: Could not resolve to an issue or pull request with the number of {n}. (repository.issue)")
    out(fields(ISSUES[int(n)]))

def cmd_pr_view():
    n = argv[2] if len(argv) > 2 and not argv[2].startswith("-") else None
    if n is None:
        fail('no pull requests found for branch "main"')
    if n in ("12", "feature/frob", URL + "/pull/12"):
        out(fields(pr_data()))
    if n in ("14", "15"):
        d = pr_data(); d.update({"number": int(n), "url": URL + "/pull/" + n})
        if n == "14":
            d.update({"isCrossRepository": True, "headRepository": {"name": "widgets", "nameWithOwner": "Fork-Owner/widgets"},
                      "headRepositoryOwner": {"login": "Fork-Owner"}, "maintainerCanModify": False})
        out(fields(d))
    if n == "13":
        d = pr_data(); d.update({"number": 13, "title": "New PR", "isDraft": True, "headRefName": "topic", "url": URL + "/pull/13", "labels": []})
        out(fields(d))
    fail(f"GraphQL: Could not resolve to a PullRequest with the number of {n}. (repository.pullRequest)")

