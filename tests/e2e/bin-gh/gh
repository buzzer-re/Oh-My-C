                  "createdAt": "2026-10-01T09:00:00Z", "updatedAt": "2026-10-03T09:00:00Z", "url": URL + "/issues/7"},
                 {"number": 9, "title": "", "state": "OPEN", "author": None, "labels": [], "createdAt": "2026-10-04T09:00:00Z", "url": URL + "/issues/9"}]
    else:
        items = [{"number": 12, "title": "Add frobnicator", "state": "OPEN", "isDraft": False, "author": {"login": "dave"},
                  "baseRefName": "main", "headRefName": "feature/frob", "labels": [{"name": "enhancement"}, {"name": "big"}],
                  "createdAt": "2026-10-04T09:00:00Z", "updatedAt": "2026-10-06T12:00:00Z", "url": URL + "/pull/12"},
                 {"number": 13, "title": "New PR", "state": "OPEN", "isDraft": True, "author": {"login": "erin"},
                  "createdAt": "2026-10-08T09:00:00Z", "updatedAt": "2026-10-08T09:00:00Z", "url": URL + "/pull/13"}]
    if state == "closed": items = []
    out([{k: v for k, v in it.items() if k in opt("--json", "").split(",")} for it in items])

def main():
    if not argv: fail("usage: gh <command>")
    if argv[0] == "api": api()
    if argv[:2] == ["repo", "view"]: cmd_repo_view()
    if argv[:2] == ["issue", "view"]: cmd_issue_view()
    if argv[:2] == ["pr", "view"]: cmd_pr_view()
    if argv[:2] in (["issue", "list"], ["pr", "list"]): cmd_list(argv[0])
    if argv[:2] == ["pr", "diff"]:
        if argv[2] == "12": sys.stdout.write(PR_DIFF); sys.exit(0)
        fail(f"could not find pull request diff: GraphQL: Could not resolve to a PullRequest with the number of {argv[2]}. (repository.pullRequest)")
    if argv[:2] == ["pr", "create"]:
        if opt("--head") == "dup":
            fail('a pull request for branch "dup" into branch "main" already exists:\n' + URL + "/pull/12")
        sys.stdout.write("\nCreating pull request for topic into main in acme/widgets\n\n" + URL + "/pull/13\n"); sys.exit(0)
    if argv[:2] == ["auth", "token"]: fail("no oauth token found for github.com")
    fail(f"unknown command \"{' '.join(argv[:2])}\" for \"gh\"")

main()
