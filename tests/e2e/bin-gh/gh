#!/usr/bin/env python3
"""Dev-only fake GitHub CLI for omc/omp tests. Never contacts GitHub and never runs a real `gh`.
Answers the exact argv the github tool and the pr:// / issue:// readers issue from canned data for the
`acme/widgets` repository (and a few error paths). Every invocation is appended to $FAKE_GH_LOG (JSONL:
argv, cwd, selected env) when set. $FAKE_GH_REMOTE names the bare git repository that backs PR heads
(headRefOid is read from it with `git rev-parse`)."""
import base64, json, os, subprocess, sys

argv = sys.argv[1:]
LOG = os.environ.get("FAKE_GH_LOG") or os.environ.get("TD_CASE_LOG")
if LOG:
    entry = {"argv": argv, "cwd": os.getcwd(),
             "env": {k: os.environ.get(k) for k in ("GH_PROMPT_DISABLED", "GIT_TERMINAL_PROMPT", "LC_MESSAGES", "GIT_EDITOR")}}
    for i, a in enumerate(argv):
        if a == "--body-file" and i + 1 < len(argv):
            try: entry["body"] = open(argv[i + 1]).read()
            except OSError: entry["body"] = None
    with open(LOG, "a") as f: f.write(json.dumps(entry) + "\n")

REPO = "acme/widgets"
URL = "https://github.com/" + REPO

def out(obj):
    sys.stdout.write(obj if isinstance(obj, str) else json.dumps(obj))
    sys.stdout.write("\n")
    sys.exit(0)

def fail(stderr, stdout="", code=1):
    if stdout: sys.stdout.write(stdout + "\n")
    sys.stderr.write(stderr + "\n")
    sys.exit(code)

def opt(name, default=None):
    if name in argv:
        i = argv.index(name)
        if i + 1 < len(argv): return argv[i + 1]
    return default

def opts(name):
    return [argv[i + 1] for i, a in enumerate(argv) if a == name and i + 1 < len(argv)]

def fields(obj):
    want = opt("--json")
    if not want: return obj
    keys = want.split(",")
    bad = [k for k in keys if k not in obj and k not in OPTIONAL_FIELDS]
    if bad: fail(f'Unknown JSON field: "{bad[0]}"')
    return {k: obj.get(k) for k in keys if k in obj}

OPTIONAL_FIELDS = {"stateReason", "homepageUrl", "primaryLanguage", "headRepository", "headRepositoryOwner"}

def in_git_repo():
    d = os.getcwd()
    while True:
        if os.path.exists(os.path.join(d, ".git")): return True
        p = os.path.dirname(d)
        if p == d: return False
        d = p

def remote_sha(ref):
    remote = os.environ.get("FAKE_GH_REMOTE")
    if not remote: return "0123456789abcdef0123456789abcdef01234567"
    r = subprocess.run(["git", "--git-dir", remote, "rev-parse", ref], capture_output=True, text=True)
    return r.stdout.strip() or "0123456789abcdef0123456789abcdef01234567"

