#!/usr/bin/env python3
"""A fake rust-analyzer for tests/e2e/lsp_reload.py: answers initialize, logs each message's method and params to
$FAKE_LSP_LOG, and echoes request params back (with FAKE_LSP_ACTIONS, answers code actions and document symbols)."""
import json, os, sys

log = os.environ.get("FAKE_LSP_LOG")


def note(o):
    if log:
        with open(log, "a") as f:
            f.write(json.dumps(o) + "\n")


def read():
    n = 0
    while True:
        line = sys.stdin.buffer.readline()
        if not line:
            return None
        if line in (b"\r\n", b"\n"):
            break
        if line.lower().startswith(b"content-length:"):
            n = int(line.split(b":")[1])
    return json.loads(sys.stdin.buffer.read(n))


def send(o):
    data = json.dumps(o).encode()
    sys.stdout.buffer.write(b"Content-Length: %d\r\n\r\n" % len(data) + data)
    sys.stdout.buffer.flush()


note({"event": "start"})
while True:
    m = read()
    if m is None:
        break
    note({"method": m.get("method"), "hasParams": "params" in m, "params": m.get("params")})
    if "id" not in m:
        if m.get("method") == "exit":
            break
        continue
    if m.get("method") == "initialize":
        send({"jsonrpc": "2.0", "id": m["id"], "result": {"capabilities": {"textDocumentSync": 1}}})
    elif m.get("method") == "textDocument/codeAction" and os.environ.get("FAKE_LSP_ACTIONS"):
        # like typescript-language-server: source actions only when `context.only` asks for them
        only = m["params"]["context"].get("only")
        fix = {"title": "Fix", "kind": "quickfix"}
        acts = [fix, {"title": "Organize Imports", "kind": "source.organizeImports"}] if only == ["source"] else [fix] if only is None else []
        send({"jsonrpc": "2.0", "id": m["id"], "result": acts})
    elif m.get("method") == "textDocument/documentSymbol" and os.environ.get("FAKE_LSP_ACTIONS"):
        rng = lambda a, b: {"start": {"line": a, "character": 0}, "end": {"line": b, "character": 1}}
        send({"jsonrpc": "2.0", "id": m["id"], "result": [{"name": "a", "kind": 12, "range": rng(0, 4), "selectionRange": rng(2, 2)}]})
    else:
        send({"jsonrpc": "2.0", "id": m["id"], "result": {"echo": m.get("params", "absent")}})
