#!/usr/bin/env python3
"""Dev-only fake GitLab CLI for the mr:// reader (omc and omp). Never contacts GitLab and never runs a real `glab`.
Answers `glab repo view -F json` (project gitlab.example.com/grp/sub/proj) and `glab mr diff <iid> -R <url> --raw
--color never` from canned data: MR 7 changes two files, MR 8 has no changes, MR 9 fails unauthenticated.
Every invocation is appended to $FAKE_GLAB_LOG (JSONL: argv, selected env) when set."""
import json, os, sys

argv = sys.argv[1:]
LOG = os.environ.get("FAKE_GLAB_LOG")
if LOG:
    with open(LOG, "a") as f:
        f.write(json.dumps({"argv": argv, "env": {k: os.environ.get(k) for k in ("GLAB_NO_PROMPT", "GLAB_CHECK_UPDATE", "NO_COLOR")}}) + "\n")

PROJECT = "https://gitlab.example.com/grp/sub/proj"
DIFF7 = """diff --git a/src/app.c b/src/app.c
index 1111111..2222222 100644
--- a/src/app.c
+++ b/src/app.c
@@ -1,3 +1,4 @@
 int main(void) {
+    init();
     return 0;
 }
diff --git a/docs/old.md b/docs/new.md
similarity index 90%
rename from docs/old.md
rename to docs/new.md
index 3333333..4444444 100644
--- a/docs/old.md
+++ b/docs/new.md
@@ -1,2 +1,2 @@
-Old title
+New title
 Body
"""

if argv[:2] == ["repo", "view"]:
    print(json.dumps({"web_url": PROJECT, "http_url_to_repo": PROJECT + ".git"}))
    sys.exit(0)
if argv[:2] == ["mr", "diff"] and len(argv) >= 5 and argv[3] == "-R":
    iid, repo = argv[2], argv[4]
    if repo.rstrip("/") != PROJECT:
        sys.stderr.write("404 Project Not Found\n")
        sys.exit(1)
    if iid == "7":
        sys.stdout.write(DIFF7)
        sys.exit(0)
    if iid == "8":
        sys.exit(0)
    if iid == "9":
        sys.stderr.write("glab: could not authenticate; run glab auth login\n")
        sys.exit(1)
    sys.stderr.write("404 Not Found\n")
    sys.exit(1)
sys.stderr.write("fake glab: unsupported command: %s\n" % " ".join(argv))
sys.exit(1)
